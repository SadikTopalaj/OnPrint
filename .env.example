# Kopier denne filen til .env for lokal utvikling (netlify dev)
# I produksjon: legg disse inn i Netlify Dashboard -> Site settings -> Environment variables
# ALDRI commit ekte nokler til Git.

# Stripe - hentes fra dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe - hentes etter at webhook-endepunktet er opprettet i Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend - hentes fra resend.com/api-keys (for a sende bestillings-e-post)
RESEND_API_KEY=re_...

# E-post som skal motta bestillinger og forespørsler
ORDER_NOTIFY_EMAIL=ahmed@onprint.no

# Settes automatisk av Netlify i produksjon (URL). Trengs kun lokalt:
URL=http://localhost:8888
